# Flask (optional)
# If unset, the app falls back to a fixed development secret key.
# The fallback is intentional so that Flask reloader restarts do not
# invalidate active sessions during a recorded demonstration.
FLASK_SECRET_KEY=change-me-for-real-deployments

# SMTP (required by mailer.py and verify_email.py; not wired into the app)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com
